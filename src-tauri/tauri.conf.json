{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bard",
  "version": "0.1.0",
  "identifier": "com.miisodev.bard",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "Bard",
        "width": 380,
        "height": 620,
        "minWidth": 340,
        "minHeight": 420,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "center": false
      },
      {
        "label": "overlay",
        "title": "Recording",
        "width": 260,
        "height": 60,
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true
      },
      {
        "label": "draw",
        "title": "Draw",
        "url": "draw.html",
        "width": 720,
        "height": 620,
        "resizable": false,
        "visible": false,
        "center": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "settings.html",
        "width": 720,
        "height": 620,
        "resizable": false,
        "visible": false,
        "center": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Capture. Dictate. Keep.",
    "longDescription": "Bard is a minimal native Windows workspace that merges clipboard capture, offline voice dictation and optional text cleanup into one keyboard-first panel.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFRTlCQzE5RTgxMjNFMzAKUldRd1BoTG9HYnpwZmtXcERMSzhKalJRVk1jWHRBK0ZuUEdWc3JSamdRMFRidDlRdHZLNFQ4dFMK",
      "endpoints": [
        "https://miiso.dev/api/bard/update?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
