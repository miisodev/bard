{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bard",
  "version": "3.0.0",
  "identifier": "com.miisodev.bard",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "Bard",
        "width": 400,
        "height": 620,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false,
        "center": false,
        "minWidth": 300,
        "minHeight": 360
      },
      {
        "label": "pill",
        "title": "Bard",
        "width": 480,
        "height": 300,
        "url": "pill.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true
      },
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "transcribe-libs/*": ".",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Clipboard, Draw and Dictate",
    "longDescription": "Bard: Clipboard, Draw and Dictate. One quiet desktop shelf for everything you copy, quick sketches, and offline dictation with a local speech model.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh",
        "customLanguageFiles": {
          "English": "nsis/English.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFRTlCQzE5RTgxMjNFMzAKUldRd1BoTG9HYnpwZmtXcERMSzhKalJRVk1jWHRBK0ZuUEdWc3JSamdRMFRidDlRdHZLNFQ4dFMK",
      "endpoints": [
        "https://miiso.dev/api/bard/update?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
