{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bard",
  "version": "0.1.0",
  "identifier": "com.miisodev.bard",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "Bard",
        "width": 380,
        "height": 620,
        "minWidth": 340,
        "minHeight": 420,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "center": false
      },
      {
        "label": "overlay",
        "title": "Recording",
        "width": 260,
        "height": 60,
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "focus": false,
        "acceptFirstMouse": true
      },
      {
        "label": "draw",
        "title": "Drawing",
        "url": "draw.html",
        "width": 760,
        "height": 560,
        "minWidth": 480,
        "minHeight": 380,
        "resizable": true,
        "visible": false,
        "center": true,
        "skipTaskbar": false
      },
      {
        "label": "settings",
        "title": "Bard Settings",
        "url": "settings.html",
        "width": 760,
        "height": 620,
        "minWidth": 620,
        "minHeight": 460,
        "resizable": true,
        "visible": false,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Capture, dictate, ask.",
    "longDescription": "Bard is a minimal native Windows workspace that merges clipboard capture, offline voice dictation and AI answers into one keyboard-first panel.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      },
      "wix": {
        "language": "en-US",
        "template": null
      }
    }
  }
}
