{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "draw",
  "description": "Bard Drawing permissions",
  "windows": [
    "draw"
  ],
  "permissions": [
    "allow-hold-windows",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-set-draw-background",
    "allow-get-appearance",
    "core:window:allow-close",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-add-image",
    "allow-copy-item",
    "allow-save-svg",
    "allow-open-draw-with-image",
    "allow-item-image-data",
    "allow-clipboard-image-data",
    "allow-set-draw-prefs",
    "dialog:allow-save",
    "allow-notify-error"
  ]
}
