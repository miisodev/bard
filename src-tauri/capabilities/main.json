{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Primary Bard panel permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-appearance",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "dialog:allow-open",
    "allow-get-state",
    "allow-get-setting-str",
    "allow-add-item",
    "allow-add-image",
    "allow-open-draw",
    "allow-open-guide",
    "allow-open-draw-with-image",
    "allow-open-settings",
    "allow-toggle-companion",
    "allow-set-sort",
    "allow-delete-item",
    "allow-set-favorite",
    "allow-set-pinned",
    "allow-clear-history",
    "allow-clear-captures",
    "allow-delete-all-data",
    "allow-copy-item",
    "allow-item-image-data",
    "allow-item-cover-url",
    "allow-set-theme",
    "allow-set-onboarding-completed",
    "allow-set-autostart",
    "allow-open-startup-settings",
    "allow-open-link",
    "allow-show-panel",
    "allow-hide-panel",
    "allow-get-models",
    "allow-set-model",
    "allow-download-model",
    "allow-download-model-cancel",
    "allow-delete-model",
    "allow-update-item",
    "allow-export-markdown",
    "allow-set-export-dir",
    "allow-get-export-dir",
    "allow-set-retention-days",
    "allow-get-retention-days",
    "allow-get-microphones",
    "allow-set-microphone",
    "allow-get-crash-report",
    "allow-check-for-update",
    "allow-install-update",
    "allow-set-dock",
    "allow-get-feedback",
    "allow-set-capture-paused",
    "allow-notify-error",
    "allow-get-shortcuts",
    "core:window:allow-set-size",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize"
  ]
}
