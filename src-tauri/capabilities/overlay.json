{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Dictation overlay permissions",
  "windows": ["overlay"],
  "permissions": [
    "allow-get-appearance",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-dictate-cancel",
    "allow-dictation-confirm",
    "allow-dictation-copy",
    "allow-dictation-dismiss"
  ]
}
