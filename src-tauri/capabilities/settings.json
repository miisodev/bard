{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Bard Settings permissions",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-get-appearance",
    "allow-set-background",
    "core:event:allow-listen",
    "core:window:allow-close",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "allow-get-state",
    "allow-get-setting-str",
    "allow-get-dictation-options",
    "allow-set-dictation-options",
    "allow-set-theme",
    "allow-set-autostart",
    "allow-configure-desktop",
    "allow-open-startup-settings",
    "allow-open-link",
    "allow-get-models",
    "allow-set-model",
    "allow-download-model",
    "allow-download-model-cancel",
    "allow-delete-model",
    "allow-export-markdown",
    "allow-set-export-dir",
    "allow-get-export-dir",
    "allow-clear-history",
    "allow-clear-captures",
    "allow-delete-all-data",
    "allow-set-retention-days",
    "allow-get-retention-days",
    "allow-prune-history-now",
    "allow-get-microphones",
    "allow-set-microphone",
    "allow-get-crash-report",
    "allow-copy-diagnostic-report",
    "allow-backup-now",
    "allow-restore-from-backup",
    "allow-check-for-update",
    "allow-install-update",
    "allow-get-feedback",
    "allow-set-feedback",
    "allow-get-stay-open",
    "allow-set-stay-open",
    "allow-hold-windows",
    "allow-get-shortcuts",
    "allow-check-shortcuts",
    "allow-save-shortcuts",
    "allow-set-shortcut",
    "allow-reset-shortcuts",
    "allow-set-dock",
    "allow-set-capture-paused"
  ]
}
